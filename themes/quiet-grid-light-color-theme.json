  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#B44F66",
        "fontStyle": "italic"
      },
      "name": "Comments"
    },
    {
      "scope": [
        "keyword",
        "storage",
        "storage.type",
        "keyword.control",
        "keyword.operator.word"
      ],
      "settings": {
        "foreground": "#A84D13",
        "fontStyle": "bold"
      },
      "name": "Keywords and storage"
    },
    {
      "scope": [
        "string",
        "punctuation.definition.string",
        "string.quoted"
      ],
      "settings": {
        "foreground": "#426F17"
      },
      "name": "Strings"
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character",
        "constant.other"
      ],
      "settings": {
        "foreground": "#C42D43",
        "fontStyle": "bold"
      },
      "name": "Numbers and constants"
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call.generic",
        "meta.function-call entity.name.function",
        "variable.function"
      ],
      "settings": {
        "foreground": "#155D95"
      },
      "name": "Functions"
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "entity.name.namespace"
      ],
      "settings": {
        "foreground": "#7040A0"
      },
      "name": "Types and classes"
    },
    {
      "scope": [
        "variable.parameter",
        "entity.name.variable.parameter",
        "meta.parameter"
      ],
      "settings": {
        "foreground": "#087888"
      },
      "name": "Parameters"
    },
    {
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "meta.property-name",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#805900"
      },
      "name": "Object properties"
    },
    {
      "scope": [
        "variable",
        "identifier"
      ],
      "settings": {
        "foreground": "#006B79"
      },
      "name": "Variables"
    },
    {
      "scope": [
        "entity.name.tag",
        "entity.name.tag.html",
        "entity.name.tag.yaml"
      ],
      "settings": {
        "foreground": "#A02D61"
      },
      "name": "Markup tags"
    },
    {
      "scope": [
        "entity.other.attribute-name",
        "entity.other.attribute-name.html"
      ],
      "settings": {
        "foreground": "#805900"
      },
      "name": "Markup attributes"
    },
    {
      "scope": [
        "string.regexp",
        "constant.regexp"
      ],
      "settings": {
        "foreground": "#557D17"
      },
      "name": "Regular expressions"
    },
    {
      "scope": [
        "keyword.operator",
        "punctuation",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#5B5550"
      },
      "name": "Operators and punctuation"
    },
    {
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#7040A0",
        "fontStyle": "bold"
      },
      "name": "Markup headings"
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#A84D13",
        "fontStyle": "bold"
      },
      "name": "Markup emphasis"
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#7040A0",
        "fontStyle": "italic"
      },
      "name": "Markup italic"
    },
    {
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#155D95",
        "fontStyle": "underline"
      },
      "name": "Markup links"
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#C42D43",
        "fontStyle": "underline"
      },
      "name": "Invalid"
    }
  ],
  "semanticTokenColors": {
    "class": "#7040A0",
    "method": "#155D95",
    "parameter": "#087888",
    "comment": {
      "foreground": "#B44F66",
      "italic": true
    },
    "property": "#805900",
    "number": {
      "foreground": "#C42D43",
      "bold": true
    },
    "enumMember": "#C04A20",
    "regexp": "#557D17",
    "operator": "#5B5550",
    "function": "#155D95",
    "string": "#426F17",
    "macro": "#7040A0",
    "keyword": {
      "foreground": "#A84D13",
      "bold": true
    },
    "variable": "#006B79",
    "type": "#7040A0"
  }
}
