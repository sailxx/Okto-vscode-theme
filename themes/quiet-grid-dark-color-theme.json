  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#E58C99",
        "fontStyle": "italic"
      },
      "name": "Comments"
    },
    {
      "scope": [
        "keyword",
        "storage",
        "storage.type",
        "keyword.control",
        "keyword.operator.word"
      ],
      "settings": {
        "foreground": "#F2AA68",
        "fontStyle": "bold"
      },
      "name": "Keywords and storage"
    },
    {
      "scope": [
        "string",
        "punctuation.definition.string",
        "string.quoted"
      ],
      "settings": {
        "foreground": "#A8D477"
      },
      "name": "Strings"
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character",
        "constant.other"
      ],
      "settings": {
        "foreground": "#FF7883",
        "fontStyle": "bold"
      },
      "name": "Numbers and constants"
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call.generic",
        "meta.function-call entity.name.function",
        "variable.function"
      ],
      "settings": {
        "foreground": "#6FB9F2"
      },
      "name": "Functions"
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "entity.name.namespace"
      ],
      "settings": {
        "foreground": "#D29AF5"
      },
      "name": "Types and classes"
    },
    {
      "scope": [
        "variable.parameter",
        "entity.name.variable.parameter",
        "meta.parameter"
      ],
      "settings": {
        "foreground": "#82DCE3"
      },
      "name": "Parameters"
    },
    {
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "meta.property-name",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#E8C66A"
      },
      "name": "Object properties"
    },
    {
      "scope": [
        "variable",
        "identifier"
      ],
      "settings": {
        "foreground": "#62D4DD"
      },
      "name": "Variables"
    },
    {
      "scope": [
        "entity.name.tag",
        "entity.name.tag.html",
        "entity.name.tag.yaml"
      ],
      "settings": {
        "foreground": "#EF8EAA"
      },
      "name": "Markup tags"
    },
    {
      "scope": [
        "entity.other.attribute-name",
        "entity.other.attribute-name.html"
      ],
      "settings": {
        "foreground": "#E8C66A"
      },
      "name": "Markup attributes"
    },
    {
      "scope": [
        "string.regexp",
        "constant.regexp"
      ],
      "settings": {
        "foreground": "#B5D97B"
      },
      "name": "Regular expressions"
    },
    {
      "scope": [
        "keyword.operator",
        "punctuation",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#D4D4D8"
      },
      "name": "Operators and punctuation"
    },
    {
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#D29AF5",
        "fontStyle": "bold"
      },
      "name": "Markup headings"
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#F2AA68",
        "fontStyle": "bold"
      },
      "name": "Markup emphasis"
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#D29AF5",
        "fontStyle": "italic"
      },
      "name": "Markup italic"
    },
    {
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#6FB9F2",
        "fontStyle": "underline"
      },
      "name": "Markup links"
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#FF7883",
        "fontStyle": "underline"
      },
      "name": "Invalid"
    }
  ],
  "semanticTokenColors": {
    "class": "#D29AF5",
    "method": "#6FB9F2",
    "parameter": "#82DCE3",
    "comment": {
      "foreground": "#E58C99",
      "italic": true
    },
    "property": "#E8C66A",
    "number": {
      "foreground": "#FF7883",
      "bold": true
    },
    "enumMember": "#FF9B70",
    "regexp": "#B5D97B",
    "operator": "#D4D4D8",
    "function": "#6FB9F2",
    "string": "#A8D477",
    "macro": "#C9A0F5",
    "keyword": {
      "foreground": "#F2AA68",
      "bold": true
    },
    "variable": "#62D4DD",
    "type": "#D29AF5"
  }
}
