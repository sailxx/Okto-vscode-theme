{
  "name": "okto-theme",
  "displayName": "Okto",
  "description": "Okto Light and Dark color themes with matching Okto file and product icon themes for Visual Studio Code.",
  "version": "2.1.0",
  "publisher": "local",
  "repository": {
    "type": "git",
    "url": "https://github.com/sailxx/okto-vscode-theme.git"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Themes"
  ],
  "contributes": {
    "themes": [
      {
        "label": "Okto Light",
        "uiTheme": "vs",
        "path": "./themes/okto-light-color-theme.json"
      },
      {
        "label": "Okto Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/okto-dark-color-theme.json"
      }
    ],
    "iconThemes": [
      {
        "label": "Okto Icons",
        "path": "./fileicons/okto-icon-theme.json",
        "id": "okto-icons"
      },
      {
        "label": "Okto Mac Icons",
        "path": "./fileicons/okto-mac-file-icon-theme.json",
        "id": "okto-mac-icons"
      }
    ],
    "productIconThemes": [
      {
        "id": "okto-product-icons",
        "label": "Okto Product Icons",
        "path": "./producticons/okto-product-icon-theme.json"
      },
      {
        "id": "okto-mac-product-icons",
        "label": "Okto Mac Product Icons",
        "path": "./producticons/okto-mac-product-icon-theme.json"
      }
    ]
  },
  "icon": "icon.png"
}
