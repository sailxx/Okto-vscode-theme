{
  "name": "okto-theme",
  "displayName": "Okto",
  "description": "Okto Light and Dark color themes with a matching Okto tile-style file icon theme for Visual Studio Code.",
  "version": "1.2.0",
  "publisher": "local",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Themes"
  ],
  "contributes": {
    "themes": [
      {
        "label": "Okto Light",
        "uiTheme": "vs",
        "path": "./themes/quiet-grid-light-color-theme.json"
      },
      {
        "label": "Okto Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/quiet-grid-dark-color-theme.json"
      }
    ],
    "iconThemes": [
      {
        "label": "Okto Icons",
        "path": "./fileicons/okto-icon-theme.json",
        "id": "okto-icons"
      }
    ]
  },
  "icon": "icon.png"
}
